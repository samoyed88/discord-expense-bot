# Example environment configuration
# Copy this file to .env and fill in the values

# Discord Bot Token (get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Google Gemini API Key (get from https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional database path
DATABASE_NAME=expenses.db

# Google Sheets integration
# Service Account JSON key file path
GOOGLE_CREDENTIALS_FILE=service_account.json
# Spreadsheet ID (from the URL: https://docs.google.com/spreadsheets/d/{THIS_PART}/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Optional: restrict quick expense messages to a specific Discord channel
# Right-click channel → Copy Channel ID (need Developer Mode enabled in Discord settings)
EXPENSE_CHANNEL_ID=
